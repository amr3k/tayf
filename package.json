{
  "name": "animaview",
  "version": "0.1.0",
  "description": "A cross-platform Lottie animation viewer for desktop and mobile devices",
  "type": "module",
  "author": {
    "name": "Amr",
    "email": "amr@a3k.me",
    "url": "https://a3k.me"
  },
  "scripts": {
    "dev": "node scripts/sync-locales.ts && vite dev",
    "build": "node scripts/sync-locales.ts && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "node scripts/sync-locales.ts && tauri",
    "i18n:extract": "wuchale",
    "i18n:clean": "wuchale --clean"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/rubik": "^5.2.8",
    "@lottiefiles/dotlottie-svelte": "^0.8.12",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@wuchale/svelte": "^0.18.0",
    "@wuchale/vite-plugin": "^0.16.1",
    "lucide-svelte": "^0.562.0",
    "wuchale": "^0.19.0"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.26",
    "@internationalized/date": "^3.10.1",
    "@lucide/svelte": "^0.562.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "2.9.6",
    "@types/node": "^25.0.3",
    "bits-ui": "^2.14.4",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "5.46.1",
    "svelte-check": "^4.3.5",
    "svelte-sonner": "^1.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unplugin-icons": "^22.5.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.0.0-beta.5"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
