{
  "name": "animaview",
  "version": "0.1.0",
  "description": "A cross-platform Lottie animation viewer for desktop and mobile devices",
  "type": "module",
  "author": {
    "name": "Amr",
    "email": "amr@a3k.me",
    "url": "https://a3k.me"
  },
  "scripts": {
    "dev": "pnpm run before && vite dev",
    "build": "pnpm run before && vite build",
    "build:appimage": "NO_STRIP=1 pnpm tauri build --bundles appimage && sh scripts/finalize-appimage.sh",
    "inspect:appimage": "sh scripts/inspect-appimage.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "pnpm run before && tauri",
    "i18n:extract": "wuchale",
    "i18n:clean": "wuchale --clean",
    "before": "node scripts/sync-locales.ts && node scripts/sync-version.ts"
  },
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/amr3k/AnimaView",
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/rubik": "^5.2.8",
    "@lottiefiles/dotlottie-svelte": "^0.10.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@wuchale/svelte": "^0.19.4",
    "lucide-svelte": "^1.0.1",
    "wuchale": "^0.23.3"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.35",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "2.11.1",
    "@types/node": "^25.6.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "5.55.5",
    "svelte-check": "^4.4.8",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.0.12"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
