{
  "name": "animaview",
  "version": "0.1.0",
  "description": "A cross-platform Lottie animation viewer for desktop and mobile devices",
  "type": "module",
  "author": {
    "name": "Amr",
    "email": "amr@a3k.me",
    "url": "https://a3k.me"
  },
  "scripts": {
    "dev": "pnpm run before && vite dev",
    "build": "pnpm run before && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "pnpm run before && tauri",
    "i18n:extract": "wuchale",
    "i18n:clean": "wuchale --clean",
    "before": "node scripts/sync-locales.ts && node scripts/sync-version.ts"
  },
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/amr3k/AnimaView",
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/rubik": "^5.2.8",
    "@lottiefiles/dotlottie-svelte": "^0.8.13",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@wuchale/svelte": "^0.18.1",
    "@wuchale/vite-plugin": "^0.16.3",
    "lucide-svelte": "^0.563.0",
    "wuchale": "^0.19.4"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.26",
    "@internationalized/date": "^3.10.1",
    "@lucide/svelte": "^0.563.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.52.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "2.9.6",
    "@types/node": "^25.0.10",
    "bits-ui": "^2.15.4",
    "clsx": "^2.1.1",
    "jsdom": "^27.4.0",
    "mode-watcher": "^1.1.0",
    "svelte": "5.48.3",
    "svelte-check": "^4.3.5",
    "svelte-sonner": "^1.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.0.0-beta.5"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
