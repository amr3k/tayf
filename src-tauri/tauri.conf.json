{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "animaview",
  "version": "0.1.0",
  "identifier": "com.animaview.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "animaview",
        "width": 960,
        "height": 540,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["json"],
        "name": "Lottie JSON",
        "mimeType": "application/json",
        "description": "Lottie Animation JSON",
        "role": "Viewer"
      },
      {
        "ext": ["lottie"],
        "name": "Lottie Binary",
        "mimeType": "application/zip",
        "description": "Lottie Animation Binary",
        "role": "Viewer"
      }
    ]
  }
}
