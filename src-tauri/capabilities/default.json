{
   "$schema": "../gen/schemas/desktop-schema.json",
   "identifier": "default",
   "description": "Capability for the main window",
   "windows": [
     "main",
     "preferences",
     "about"
   ],
   "permissions": [
     "core:default",
     "core:window:allow-set-focus",
     "core:webview:allow-create-webview-window",
     "shell:allow-open",
     "dialog:default",
     "fs:allow-write-file",
     "fs:allow-read-file",
     "fs:allow-read-dir",
     "fs:allow-copy-file",
     "fs:allow-mkdir",
     "fs:allow-remove",
     "fs:allow-rename",
     "fs:allow-exists",
     "fs:scope-app"
   ]
}
